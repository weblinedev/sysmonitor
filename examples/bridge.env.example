# Copy to /etc/sysmonitor/bridge.env with mode 0600, root:root.
# Generate independent secrets with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN
TELEGRAM_OWNER_ID=REPLACE_WITH_VERIFIED_NUMERIC_USER_ID
KUMA_WEBHOOK_TOKEN=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
TELEMETRY_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
KUMA_API_KEY=REPLACE_WITH_KUMA_READ_ONLY_METRICS_KEY
KUMA_URL=http://127.0.0.1:3001
LISTEN_HOST=127.0.0.1
LISTEN_PORT=9081
STATE_DB=/var/lib/sysmonitor/state.sqlite3
